#!/bin/sh

#
# Script used by hostapps updater to flash bootloader onto internal media
#

set -o errexit

# machine specific data

uboot_file="imx-boot-imx8mm-var-dart*-sd.bin-flash_lpddr4_ddr4_evk"
uboot_block_size=1024
uboot_seek_blocks=33

device="/dev/mmcblk2"

update_files="uboot"

for i in $update_files; do
        pattern=$(eval echo \$${i}_file)
        block_size=$(eval echo \$${i}_block_size)
        seek_blocks=$(eval echo \$${i}_seek_blocks)

        # Select the first matching file if multiple exist
        current_update_file=$(ls -1 /boot/$pattern 2>/dev/null | head -n 1)

        if [ -z "$current_update_file" ]; then
                echo "Error: No matching file found for pattern /boot/$pattern" >&2
                exit 1
        fi

        # calculate size and md5sum of the binary using the fully resolved explicit path
        update_size=$(ls -al "$current_update_file" | awk '{print $5}')
        update_md5sum=$(md5sum "$current_update_file" | awk '{print $1}')

        skip_bytes=$((block_size * seek_blocks))

        # calculate md5sum of the data already written to $device, using $update_size bytes and skipping $skip_bytes from $device
        existing_md5sum=$(dd if=$device skip=$skip_bytes bs=1 count=$update_size status=none | md5sum | awk '{print $1}')

        if [ ! "$existing_md5sum" = "$update_md5sum" ]; then
                echo "Flashing $current_update_file to $device"
                dd if="$current_update_file" of=$device conv=fdatasync seek=$seek_blocks bs=$block_size
        fi
done
